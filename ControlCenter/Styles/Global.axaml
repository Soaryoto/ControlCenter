<Styles
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="Grid.DefaultStyleGrid">
        <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
    </Style>

    <Style Selector="ListBox.DefaultBGStyleListBox">
        <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
    </Style>

    <Style Selector="ListBox.DefaultBorderStyleListBox">
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="CornerRadius" Value="2"/>
    </Style>

    <Style Selector="ListBox.LogViewerContainer">
        <Setter Property="Padding" Value="0"/>
    </Style>
</Styles>