<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Soaryoto.ViewModels.Controls"
    xmlns:model="using:Soaryoto.Models"
    x:Class="Soaryoto.Views.Controls.LogViewer"
    x:DataType="vm:LogViewerViewModel">

    <ListBox x:Name="LogListBox" ItemsSource="{Binding Logs}">
        <ListBox.ItemTemplate>
            <DataTemplate x:DataType="model:LogEntry">
                <Grid ColumnDefinitions="Auto,Auto,*"
                    Margin="2">

                    <TextBlock Text="{Binding TimeString}"
                        Grid.Column="0"
                        FontSize="12" TextWrapping="Wrap" FontFamily="Consolas"/>

                    <TextBlock Text=")"
                        Grid.Column="1"
                        FontSize="12" TextWrapping="Wrap" FontFamily="Consolas"/>

                    <TextBlock Text="{Binding Message}"
                        Grid.Column="2"
                        FontSize="12" TextWrapping="Wrap" FontFamily="Consolas"/>

                </Grid>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>

</UserControl>
