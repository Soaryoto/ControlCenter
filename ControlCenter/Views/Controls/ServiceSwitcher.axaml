<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Soaryoto.ViewModels.Controls"
    xmlns:model="using:Soaryoto.ViewModels.Items"
    x:Class="Soaryoto.Views.Controls.ServiceSwitcher"
    x:DataType="vm:ServiceSwitcherViewModel">

    <ListBox Classes="DefaultBGStyleListBox DefaultBorderStyleListBox" x:Name="ServicesListBox" ItemsSource="{Binding ServicesItems}">
        <ListBox.ItemTemplate>
            <DataTemplate x:DataType="model:ServiceItemViewModel">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                    Margin="2">

                    <TextBlock Text="{Binding Name}"
                        Grid.Row="0" Grid.Column="0"
                        FontSize="12" TextWrapping="Wrap" FontFamily="Consolas"/>

                    <TextBlock Text=")"
                        Grid.Row="0" Grid.Column="1"
                        FontSize="12" TextWrapping="Wrap" FontFamily="Consolas"/>

                    <TextBlock Text="{Binding State}"
                        Grid.Row="0" Grid.Column="2"
                        FontSize="12" TextWrapping="Wrap" FontFamily="Consolas"/>

                    <Button Classes="primary"
                        Grid.Row="0" Grid.Column="3"
                        Content="Переключить состояние"
                        Command="{Binding ToggleCommand}" />
                </Grid>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>

</UserControl>
