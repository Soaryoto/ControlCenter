<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Soaryoto.ViewModels"
        xmlns:controls="using:Soaryoto.Views.Controls"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Soaryoto.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/black-dragon.ico"
        Title="Soaryoto">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid Classes="DefaultStyleGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <controls:LogViewer DataContext="{Binding LogsData}"
            Grid.Row="0" Grid.Column="0"/>
            
        <Grid
            Grid.Row="0" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <TextBox IsReadOnly="True" Text="Test" Grid.Row="0" Grid.Column="0"/>
            <TextBox Text="Test" Grid.Row="1" Grid.Column="0"/>
        </Grid>
        
        <controls:ServiceSwitcher DataContext="{Binding ServiceSwitcherData}"
            Grid.Row="0" Grid.Column="2"/>
            
    </Grid>

</Window>
